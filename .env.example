# ============================================
# 复制本文件，另存为 .env，然后填入你自己的密钥
#
# .env 已被 .gitignore 忽略，永远不会提交到云端
# 本文件（.env.example）会被提交，方便队友知道要填哪些字段
# ============================================

# 大模型 API 密钥（答疑模块用，填你实际使用的那个）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 自定义接口地址（如果用官方接口可留空）
OPENAI_BASE_URL=

# 模型名称
MODEL_NAME=deepseek-chat
